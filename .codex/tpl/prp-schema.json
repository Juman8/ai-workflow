{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PRP Structured Front-Matter",
  "description": "Machine-readable schema for PRP YAML front-matter blocks",
  "type": "object",
  "required": ["task_id", "title", "target_files", "acceptance_criteria", "quality_gate"],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]+$",
      "description": "e.g. SCR-003, API-012, BUG-007"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "target_files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "type", "test_hint"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "type": {
            "type": "string",
            "enum": ["functional", "integration", "visual", "performance", "security"]
          },
          "test_hint": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "quality_gate": {
      "type": "object",
      "required": ["min_score", "max_iterations"],
      "additionalProperties": false,
      "properties": {
        "min_score": {
          "type": "integer",
          "minimum": 50,
          "maximum": 100
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "specs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "code": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
