#!/bin/bash

# Define colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${BLUE}🚀 Bắt đầu khởi tạo AI Agentic Workflow (Codex/Claude)...${NC}"

# 1. Create directories
mkdir -p .codex/agents
mkdir -p .codex/templates

echo -e "${GREEN}📁 Đã tạo thư mục .codex/agents và .codex/templates${NC}"

# 2. Create workflow.md
cat << 'EOF' > .codex/workflow.md
# Codex/Claude Workflow Policy

This document defines the strict workflow that AI Agents MUST follow for every task in this repository.

## Workflow Overview

```mermaid
flowchart TD
    A[DISCOVERY: Understand Requirements] --> B[PLANE: Create/Update Issue]
    B --> C[PLAN: Files, Arch, Risks, Tests]
    C --> D{HUMAN GATE: APPROVE}
    D -- NO --> C
    D -- YES --> E[IMPLEMENT: Main Agent]
    E --> F[PARALLEL REVIEW]
    
    subgraph F [PARALLEL REVIEW]
        F1[Code Quality]
        F2[UI/UX]
        F3[Performance]
        F4[Security]
        F5[Testing]
    end
    
    F --> G[AGGREGATE FINDINGS]
    G --> H{Findings to Fix?}
    H -- YES --> E
    H -- NO --> I[FINAL SECURITY REVIEW]
    I --> J[FINAL CHECK: compile, lint, test]
    J --> K[HUMAN REVIEW: DONE]
```

## Human Approval Gate
- Agents MUST NOT modify source code before the implementation plan (`.codex/templates/plan.md`) receives explicit human approval.
- Ambiguous responses must NOT be treated as approval. Look for "APPROVE", "APPROVED", "Proceed", or "Execute the plan".

## Review Agents
Review agents operate in a read-only capacity. They report findings based on `.codex/templates/review-report.md`.
EOF

# 3. Create templates
cat << 'EOF' > .codex/templates/plan.md
# Implementation Plan: [Issue-ID] [Feature Name]

## 1. Goal Description
[Brief description of the problem, context, and what the change accomplishes]

## 2. Open Questions & Risks
> [!WARNING]
> [Any critical questions or design decisions that need Human input before proceeding]

## 3. Proposed Changes (Architecture & Files)

### Component: [Component Name]
- **[NEW]** `path/to/new_file.ts`: [Why it's needed]
- **[MODIFY]** `path/to/existing_file.tsx`: [What will change]
- **[DELETE]** `path/to/old_file.ts`: [Why it's removed]

## 4. Testing Strategy
- **Unit Tests**: [Files to test, scenarios]
- **E2E/UI Tests**: [Maestro flows to update or create]
- **Manual Verification**: [Steps for the Human reviewer]

---
*Waiting for Explicit Human Approval ("APPROVE") before modifying any code.*
EOF

cat << 'EOF' > .codex/templates/review-report.md
# Agent Review Report
**Agent:** [Code Quality | UI/UX | Performance | Security | Testing]
**Status:** [PASS | FAIL - Action Required]

## Findings

| ID | Severity | File | Problem | Recommendation | Confidence |
|---|---|---|---|---|---|
| 01 | [BLOCKER/HIGH/MEDIUM/LOW/INFO] | `path/to/file` | [Description] | [How to fix] | [High/Med/Low] |

---
**Severity Definitions:**
- **BLOCKER**: Prevents compilation, breaks critical flows. Must fix immediately.
- **HIGH**: Significant issues. Must fix before final check.
- **MEDIUM**: Code smells, non-critical bugs. Should fix.
- **LOW**: Minor formatting, naming. Optional fix.
- **INFO**: Suggestions for future improvements.
EOF

# 4. Create agents
cat << 'EOF' > .codex/agents/code-quality.md
# System Prompt: Code Quality Agent
**Role:** Code Quality Agent in parallel review.
**Goal:** Ensure code adheres to standards, is maintainable, and uses appropriate TypeScript/React patterns.
**Constraints:** READ-ONLY. Output using `.codex/templates/review-report.md`.
EOF

cat << 'EOF' > .codex/agents/ui-ux.md
# System Prompt: UI/UX Agent
**Role:** UI/UX Agent in parallel review.
**Goal:** Ensure UI matches requirements, is accessible, responsive, and handles loading/errors.
**Constraints:** READ-ONLY. Output using `.codex/templates/review-report.md`.
EOF

cat << 'EOF' > .codex/agents/performance.md
# System Prompt: Performance Agent
**Role:** Performance Agent in parallel review.
**Goal:** Identify unnecessary re-renders, list performance issues, and bundle size bloat.
**Constraints:** READ-ONLY. Output using `.codex/templates/review-report.md`.
EOF

cat << 'EOF' > .codex/agents/security.md
# System Prompt: Security Agent
**Role:** Security Agent in parallel review.
**Goal:** Identify vulnerabilities, validate inputs, verify data storage and network security.
**Constraints:** READ-ONLY. Output using `.codex/templates/review-report.md`.
EOF

cat << 'EOF' > .codex/agents/testing.md
# System Prompt: Testing Agent
**Role:** Testing Agent in parallel review.
**Goal:** Ensure code is covered by tests, edge cases handled, and Maestro E2E updated.
**Constraints:** READ-ONLY. Output using `.codex/templates/review-report.md`.
EOF

cat << 'EOF' > .codex/agents/security-review.md
# System Prompt: Final Security Gate
**Role:** Final Security Reviewer.
**Goal:** Perform the final security sign-off before completion. 
**Rules:** 
- A task CANNOT be completed if a BLOCKER or HIGH finding remains.
- Output verdict: `[SECURITY-APPROVED]` or `[SECURITY-REJECTED]`.
EOF

echo -e "${GREEN}✅ Đã setup xong toàn bộ AI Workflow trong thư mục .codex!${NC}"
echo -e "${YELLOW}Bạn có thể bắt đầu sử dụng dự án này với Claude/Codex ngay bây giờ.${NC}"
